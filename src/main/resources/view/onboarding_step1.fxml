<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.educonnect.OnboardingStep1Controller">
    <children>
        <VBox alignment="CENTER" layoutX="250.0" layoutY="30.0" spacing="10.0">
            <children>
                <Label style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-padding: 8 12; -fx-background-radius: 8;" text="E" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Label text="Educonnect">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <AnchorPane layoutX="150.0" layoutY="130.0" prefHeight="420.0" prefWidth="500.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <children>
                <Label alignment="CENTER" layoutX="130.0" layoutY="30.0" prefWidth="240.0" text="🎓 EDUCONNECT Onboarding" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" layoutX="200.0" layoutY="55.0" text="Step 1 of 3" textFill="#64748b">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <ProgressBar layoutX="50.0" layoutY="90.0" prefHeight="8.0" prefWidth="400.0" progress="0.33" style="-fx-accent: #0ea5e9;" />

                <Label alignment="CENTER" layoutX="200.0" layoutY="130.0" text="👋 Welcome" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <Label alignment="CENTER" layoutX="50.0" layoutY="180.0" prefWidth="400.0" text="You are about to join EDUCONNECT —" textAlignment="CENTER" textFill="#475569">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" layoutX="50.0" layoutY="205.0" prefWidth="400.0" text="a platform for discussions, quizzes, and" textAlignment="CENTER" textFill="#475569">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" layoutX="50.0" layoutY="230.0" prefWidth="400.0" text="academic collaboration." textAlignment="CENTER" textFill="#475569">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <Button fx:id="nextButton" layoutX="340.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleNext" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 6;" text="Next ➔">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
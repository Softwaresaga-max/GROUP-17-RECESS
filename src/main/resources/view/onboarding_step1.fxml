<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color:#f8fafc;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.educonnect.OnboardingStep1Controller">


    <children>


        <!-- HEADER -->
        <VBox alignment="CENTER"
              layoutX="300.0"
              layoutY="30.0"
              spacing="8.0">

            <children>

                <Label text="E"
                       textFill="WHITE"
                       style="-fx-background-color:#4f46e5;
                              -fx-padding:8 14;
                              -fx-background-radius:10;">

                    <font>
                        <Font name="System Bold" size="22"/>
                    </font>

                </Label>


                <Label text="EduConnect"
                       textFill="#1e293b">

                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>

                </Label>


            </children>

        </VBox>





        <!-- CARD -->

        <AnchorPane layoutX="150"
                    layoutY="130"
                    prefHeight="420"
                    prefWidth="500"
                    style="-fx-background-color:white;
                           -fx-background-radius:15;
                           -fx-effect:dropshadow(three-pass-box,
                           rgba(0,0,0,0.08),10,0,0,4);">


            <children>



                <Label layoutX="100"
                       layoutY="35"
                       prefWidth="300"
                       alignment="CENTER"
                       text="🎓 EDUCONNECT ONBOARDING"
                       textFill="#1e293b">

                    <font>
                        <Font name="System Bold" size="16"/>
                    </font>

                </Label>




                <Label layoutX="200"
                       layoutY="65"
                       text="Step 1 of 3"
                       textFill="#64748b">

                    <font>
                        <Font size="13"/>
                    </font>

                </Label>





                <ProgressBar layoutX="50"
                             layoutY="100"
                             prefWidth="400"
                             prefHeight="10"
                             progress="0.33"/>






                <Label layoutX="150"
                       layoutY="150"
                       text="👋 Welcome"
                       textFill="#1e293b">

                    <font>
                        <Font name="System Bold" size="22"/>
                    </font>

                </Label>





                <Label layoutX="60"
                       layoutY="210"
                       prefWidth="380"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       text="Welcome to EduConnect.
Your academic discussion and collaboration platform."
                       wrapText="true"
                       textFill="#475569">

                    <font>
                        <Font size="14"/>
                    </font>

                </Label>






                <!-- NEXT BUTTON -->

                <Button fx:id="nextButton"
                        layoutX="340"
                        layoutY="340"
                        prefWidth="110"
                        prefHeight="38"
                        text="Next ➔"
                        onAction="#handleNext"
                        style="-fx-background-color:#0ea5e9;
                               -fx-text-fill:white;
                               -fx-background-radius:8;">

                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>

                </Button>




            </children>


        </AnchorPane>



    </children>


</AnchorPane>
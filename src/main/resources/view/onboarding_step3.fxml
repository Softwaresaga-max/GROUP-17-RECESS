<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.educonnect.OnboardingStep3Controller">
    <children>
        <VBox alignment="CENTER" layoutX="250.0" layoutY="30.0" spacing="10.0">
            <children>
                <Label style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-padding: 8 12; -fx-background-radius: 8;" text="E" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Label text="Educonnect">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <AnchorPane layoutX="150.0" layoutY="130.0" prefHeight="420.0" prefWidth="500.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <children>
                <Label alignment="CENTER" layoutX="130.0" layoutY="30.0" prefWidth="240.0" text="🎓 EDUCONNECT Onboarding" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" layoutX="200.0" layoutY="55.0" text="Step 3 of 3" textFill="#64748b">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <ProgressBar layoutX="50.0" layoutY="90.0" prefHeight="8.0" prefWidth="400.0" progress="1.0" style="-fx-accent: #10b981;" />

                <Label alignment="CENTER" layoutX="100.0" layoutY="115.0" prefWidth="300.0" text="📜 Platform Rules Acceptance" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>

                <Label alignment="CENTER" layoutX="50.0" layoutY="145.0" prefWidth="400.0" text="Please read and accept the rules to continue:" textFill="#475569">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <Label layoutX="70.0" layoutY="180.0" text="✓ Respect all users" textFill="#334155" />
                <Label layoutX="70.0" layoutY="205.0" text="✓ No spam or cheating" textFill="#334155" />
                <Label layoutX="70.0" layoutY="230.0" text="✓ Violations may lead to account suspension" textFill="#ef4444" />

                <Button fx:id="backButton" layoutX="50.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #cbd5e1; -fx-text-fill: #1e293b; -fx-background-radius: 6;" text="← Back">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>

                <Button fx:id="finishButton" layoutX="340.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleFinish" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6;" text="Finish 🎉">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.educonnect.StudentDashboardController">
    <children>
        <VBox alignment="CENTER" layoutX="50.0" layoutY="40.0" spacing="5.0">
            <children>
                <Label text="🎓 Student Dashboard" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Welcome back to Educonnect" textFill="#64748b">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <AnchorPane layoutX="50.0" layoutY="120.0" prefHeight="430.0" prefWidth="700.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <children>
                <Label layoutX="30.0" layoutY="30.0" text="Quick Navigation" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>

                <Button fx:id="logoutButton" layoutX="560.0" layoutY="30.0" mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6;" text="Logout">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Label layoutX="30.0" layoutY="100.0" text="• Access discussion forums and collaborate with peers." textFill="#475569">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label layoutX="30.0" layoutY="140.0" text="• Take quizzes and review your academic progress." textFill="#475569">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label layoutX="30.0" layoutY="180.0" text="• View announcements from your lecturers." textFill="#475569">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
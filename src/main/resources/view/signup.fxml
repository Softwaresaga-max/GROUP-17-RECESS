<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.educonnect.SignupController">
    <children>
        <AnchorPane layoutX="200.0" layoutY="80.0" prefHeight="440.0" prefWidth="400.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <children>
                <Label layoutX="130.0" layoutY="25.0" text="Create Account" textFill="#1e293b">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>

                <VBox layoutX="40.0" layoutY="70.0" spacing="12.0" prefWidth="320.0">
                    <children>
                        <Label text="Select Role" textFill="#1e293b"/>
                        <ComboBox fx:id="roleComboBox" prefWidth="320.0" style="-fx-background-radius: 6;" />

                        <Label text="Full Name" textFill="#1e293b"/>
                        <TextField fx:id="nameField" promptText="Enter your full name" prefHeight="30.0" style="-fx-background-radius: 6;" />

                        <Label text="Email Address" textFill="#1e293b"/>
                        <TextField fx:id="emailField" promptText="Enter your email" prefHeight="30.0" style="-fx-background-radius: 6;" />

                        <Label text="Password" textFill="#1e293b"/>
                        <PasswordField fx:id="passwordField" promptText="Enter password" prefHeight="30.0" style="-fx-background-radius: 6;" />
                    </children>
                </VBox>

                <Button fx:id="submitButton" layoutX="40.0" layoutY="370.0" mnemonicParsing="false" onAction="#handleRegister" prefHeight="35.0" prefWidth="320.0" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 6;" text="Continue to Onboarding">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
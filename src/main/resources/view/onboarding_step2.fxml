<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="600.0"
            prefWidth="800.0"
            style="-fx-background-color:#f8fafc;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.educonnect.OnboardingStep2Controller">


    <children>


        <VBox alignment="CENTER"
              layoutX="300.0"
              layoutY="30.0"
              spacing="8.0">

            <children>

                <Label text="E"
                       textFill="WHITE"
                       style="-fx-background-color:#4f46e5;
                              -fx-padding:8 14;
                              -fx-background-radius:10;">

                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>

                </Label>


                <Label text="EduConnect">

                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>

                </Label>


            </children>

        </VBox>





        <AnchorPane layoutX="150.0"
                    layoutY="120.0"
                    prefHeight="450.0"
                    prefWidth="500.0"
                    style="-fx-background-color:white;
                           -fx-background-radius:15;
                           -fx-effect:dropshadow(three-pass-box,
                           rgba(0,0,0,0.08),10,0,0,4);">


            <children>


                <Label layoutX="130.0"
                       layoutY="30.0"
                       text="Student Information"
                       textFill="#1e293b">

                    <font>
                        <Font name="System Bold" size="20.0"/>
                    </font>

                </Label>



                <Label layoutX="205.0"
                       layoutY="65.0"
                       text="Step 2 of 3"
                       textFill="#64748b"/>




                <ProgressBar layoutX="50.0"
                             layoutY="100.0"
                             prefWidth="400.0"
                             progress="0.66"/>





                <VBox layoutX="70.0"
                      layoutY="150.0"
                      spacing="15.0"
                      prefWidth="360.0">


                    <children>


                        <TextField fx:id="nameField"
                                   promptText="Full Name"/>



                        <TextField fx:id="registrationField"
                                   promptText="Registration Number"/>



                        <TextField fx:id="courseField"
                                   promptText="Programme / Course"/>



                        <ComboBox fx:id="yearComboBox"
                                  promptText="Year of Study"/>


                    </children>


                </VBox>






                <Button fx:id="nextButton"
                        layoutX="340.0"
                        layoutY="370.0"
                        prefWidth="110.0"
                        text="Next ➔"
                        onAction="#handleNext"
                        style="-fx-background-color:#0ea5e9;
                               -fx-text-fill:white;
                               -fx-background-radius:8;">


                    <font>

                        <Font name="System Bold"
                              size="14.0"/>

                    </font>


                </Button>




            </children>


        </AnchorPane>


    </children>


</AnchorPane>